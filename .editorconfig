# Muharrir sozlamalari: TS/TSX 2 bo'sh joy, Java 4 bo'sh joy (AGENTS.md)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ts,tsx,js,mjs,cjs,json,yml,yaml,css,html}]
indent_style = space
indent_size = 2

[*.java]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{cmd,bat}]
end_of_line = crlf
