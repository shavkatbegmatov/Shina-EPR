#!/usr/bin/env sh
#
# Commit xabari Conventional Commits shaklida bo'lishini tekshiradi:
#   type(scope)?: sarlavha        masalan  fix(sales): ...   docs: ...
#
# Nega kerak: tarixda `frontend:`, `front:`, `seo:`, `deploy:` kabi tasodifiy
# "type"lar va BOM bilan boshlangan sarlavhalar bor — release.yml va CHANGELOG
# ularni guruhlay olmaydi. AGENTS.md qoidasi endi hook bilan mustahkamlanadi.
#
# Yoqish (klondan keyin bir marta):  git config core.hooksPath .githooks
# Chetlab o'tish: git commit --no-verify

set -u

msg_file="$1"
# Birinchi bo'sh bo'lmagan, izoh bo'lmagan qator = sarlavha. BOM olib tashlanadi.
subject=$(grep -v '^#' "$msg_file" | sed '1s/^\xEF\xBB\xBF//' | grep -m1 -v '^[[:space:]]*$')

# Merge/revert/fixup kabi git yasagan sarlavhalar tekshirilmaydi
case "$subject" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

if ! printf '%s' "$subject" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert|security)(\([a-z0-9._/-]+\))?!?: .{1,}$'; then
  cat >&2 <<MSG

  Commit sarlavhasi Conventional Commits shaklida emas:
    $subject

  Kutilgan:  type(scope): sarlavha
  Turlar:    feat fix docs style refactor perf test build ci chore revert security
  Misol:     fix(sales): pul olingan sotuvni bekor qilishni taqiqlash

  Chetlab o'tish: git commit --no-verify

MSG
  exit 1
fi
